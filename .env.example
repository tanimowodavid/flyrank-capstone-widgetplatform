# Copy to .env and adjust. Never commit the real .env — it is gitignored.

# Application
PROJECT_NAME="FlyRank Widget Platform"
DEBUG=true

# PostgreSQL
# These three are consumed by both the app and the postgres container.
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flyrank

# Host/port as seen from outside Docker (host-side alembic or pytest runs).
# docker-compose.yml overrides these to db:5432 for the app container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Database the test session creates, migrates and drops. Leave unset to get
# "<POSTGRES_DB>_test". pytest refuses to run if this equals POSTGRES_DB.
# POSTGRES_TEST_DB=flyrank_test

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# JWT
# Required — the app refuses to start without it. Generate a fresh one per
# environment, and never reuse this placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
